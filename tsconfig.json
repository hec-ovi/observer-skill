{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": [
    "bin/**/*.ts",
    "scripts/**/*.ts",
    "shared/**/*.ts",
    "boxes/session/**/*.ts",
    "boxes/ingest/**/*.ts",
    "boxes/transcript/**/*.ts",
    "boxes/knowledge/**/*.ts",
    "boxes/artifact/**/*.ts",
    "boxes/web-host/**/*.ts",
    "boxes/agent-io/**/*.ts"
  ]
}
